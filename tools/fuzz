#!/bin/sh
# Run the fuzz targets for N seconds each (default 60). Needs nightly Rust and cargo-fuzz:
#   rustup toolchain install nightly --profile minimal && cargo +nightly install cargo-fuzz --locked
set -eu
cd "$(dirname "$0")/../fuzz"
secs="${1:-60}"
for t in snapshot_json logs; do
    mkdir -p "corpus/$t"
    cp -n seeds/"$t"/* "corpus/$t"/ 2>/dev/null || true
    cargo +nightly fuzz run "$t" -- -max_total_time="$secs"
done
